# Dockerfile.debug.ui-api
# Standalone debug image: compiles UiApi in Debug mode with vsdbg for remote debugging.
# Build context: /opt/saltminer-dev/saltminer

# ── Stage 1: Debug build from source ─────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /opt/saltminer-dev/saltminer
COPY . .
RUN dotnet publish Saltworks.SaltMiner.Ui.Api/Saltworks.SaltMiner.Ui.Api/Saltworks.SaltMiner.Ui.Api.csproj \
    --configuration Debug \
    --output /app/debug \
    --no-self-contained

# ── Stage 2: Runtime with vsdbg ──────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

# Install vsdbg FIRST (this layer caches well since it rarely changes)
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip bash \
 && curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg \
 && rm -rf /var/lib/apt/lists/*

# Copy debug artifacts LAST (this layer rebuilds with each code change)
COPY --from=build /app/debug/ .

ENV ASPNETCORE_ENVIRONMENT=Development
ENV DOTNET_ENABLE_DIAGNOSTICS=1
ENV ASPNETCORE_URLS=http://+:5001

EXPOSE 5001
ENTRYPOINT ["dotnet", "Saltworks.SaltMiner.Ui.Api.dll"]
