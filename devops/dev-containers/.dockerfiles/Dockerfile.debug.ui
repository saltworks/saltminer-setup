# Dockerfile.debug.ui
# Vite dev server for the SaltMiner Vue.js frontend.
# Source is bind-mounted at runtime via docker-compose-debug.yml — no COPY needed.
# Build context: /opt/saltminer-dev/saltminer (for .dockerignore resolution only).
# The actual UI source is supplied via bind mount:
#   volumes:
#     - /opt/saltminer-dev/saltminer/src/SaltMiner.Ui:/app

FROM node:20-alpine

# Install bash (some npm scripts may require it)
RUN apk add --no-cache bash

WORKDIR /app

# Source directory is bind-mounted at runtime
# npm install runs on every container start to ensure deps match current source
EXPOSE 5173
# Chrome DevTools Protocol port (for VS Code TypeScript/Vue debugging)
EXPOSE 9229

CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0"]
