[Unit]
Description=SaltMiner Dev Orchestration API
Documentation=https://github.com/saltworks/saltminer
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=saltminer
WorkingDirectory=/opt/saltminer-dev/control-api
EnvironmentFile=/opt/saltminer-dev/control-api/.env
ExecStart=/opt/saltminer-dev/control-api/run-api.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
