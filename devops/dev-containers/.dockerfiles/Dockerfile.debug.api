# Dockerfile.debug.api
# Standalone debug image: compiles DataApi in Debug mode with vsdbg for remote debugging.
# Build context: /opt/saltminer-dev/saltminer (the saltminer source repo)
# Build command (handled by Flask orchestration API):
#   docker build \
#     -f /opt/saltminer-dev/saltminer-setup/devops/dev-containers/.dockerfiles/Dockerfile.debug.api \
#     -t saltminer-api-debug:latest \
#     /opt/saltminer-dev/saltminer

# ── Stage 1: Debug build from source ─────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /opt/saltminer-dev/saltminer
COPY . .
# Remove any stale build artifacts copied from the host (bin/, obj/).
# Without this, NETSDK1152 fires when publish finds duplicate .xml paths
# (source-level doc XML vs. bin/Debug/net8.0/ XML from a prior local build).
RUN find . -type d \( -name "bin" -o -name "obj" \) -prune -exec rm -rf {} \; ; \
    dotnet publish Saltworks.SaltMiner.DataApi/Saltworks.SaltMiner.DataApi/Saltworks.SaltMiner.DataApi.csproj \
    --configuration Debug \
    --output /app/debug \
    --no-self-contained

# ── Stage 2: Runtime with vsdbg ──────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

# Install vsdbg FIRST (this layer caches well since it rarely changes)
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip bash \
 && curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg \
 && rm -rf /var/lib/apt/lists/*

# Copy debug artifacts LAST (this layer rebuilds with each code change)
COPY --from=build /app/debug/ .

ENV ASPNETCORE_ENVIRONMENT=Development
ENV DOTNET_ENABLE_DIAGNOSTICS=1
ENV ASPNETCORE_URLS=http://+:5000

EXPOSE 5000
ENTRYPOINT ["dotnet", "Saltworks.SaltMiner.DataApi.dll"]
